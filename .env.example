# Non-secret settings only. Real environment variables override this file.
# API keys (ANTHROPIC_API_KEY, OPENAI_API_KEY) are never stored here: export them in your shell.

# System 1 (fast decisions, local Ollama decision model via /v1/systemone)
OLLAMA_BASE_URL=http://localhost:11434
# Alternatives: nimble-v3:9b-q4_K_M (non-commercial licence), d1:3b
ACS_S1_MODEL=tev1:4b
ACS_S1_CONCURRENCY=4
ACS_S1_TIMEOUT_S=30
ACS_S1_CONF_MIN=0.6
ACS_S1_MARGIN_MIN=0.15

# Sellers: slow-decision trigger check interval (ticks)
ACS_SELLER_TRIGGER_EVERY=5

# Sellers with --sellers llm (System 2). Any Pydantic AI model string:
#   anthropic:claude-haiku-5-5 (needs ANTHROPIC_API_KEY), openai:gpt-5-mini (needs OPENAI_API_KEY)
ACS_SELLER_MODEL=anthropic:claude-haiku-5-5
ACS_LLM_CONCURRENCY=5
ACS_LLM_TIMEOUT_S=60
